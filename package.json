{
  "name": "llm-usage-monitor",
  "productName": "LLM Usage Monitor",
  "version": "0.9.0",
  "description": "Windows tray monitor for Codex and Claude Code usage quotas",
  "author": {
    "name": "Innnteraction",
    "email": "innnteractive@gmail.com"
  },
  "private": true,
  "main": ".vite/build/main.js",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.15 <10"
  },
  "scripts": {
    "dev": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:smoke:codex": "vitest run tests/smoke/codex.smoke.test.ts --config vitest.smoke.config.mts",
    "test:smoke:local-usage": "vitest run tests/smoke/local-usage.smoke.test.ts --config vitest.smoke.config.mts",
    "test:smoke:claude-pty": "vitest run --config vitest.claude-smoke.config.mts",
    "test:smoke:claude-packaged": "pnpm package && playwright test --config playwright.claude-packaged.config.ts",
    "test:e2e": "pnpm package && playwright test",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "postinstall": "node -e \"if (process.platform === 'darwin') { const { execSync } = require('child_process'); try { execSync('chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper'); } catch {} }\"",
    "install:app": "node ./scripts/deploy.mjs",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:autostart": "node ./scripts/deploy.mjs --autostart",
    "deploy:quick": "node ./scripts/deploy.mjs --skip-build",
    "deploy:uninstall": "node ./scripts/deploy.mjs --uninstall",
    "deploy:mac": "bash ./scripts/deploy-mac.sh",
    "deploy:mac:autostart": "bash ./scripts/deploy-mac.sh --autostart",
    "deploy:mac:quick": "bash ./scripts/deploy-mac.sh --skip-build",
    "deploy:mac:uninstall": "bash ./scripts/deploy-mac.sh --uninstall",
    "deploy:win": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-windows.ps1",
    "deploy:win:autostart": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-windows.ps1 -AutoStart",
    "deploy:win:quick": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-windows.ps1 -SkipBuild",
    "deploy:win:uninstall": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-windows.ps1 -Uninstall"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "node-pty": "1.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
