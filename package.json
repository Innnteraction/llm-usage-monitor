{
  "name": "llm-usage-monitor-workspace",
  "version": "0.13.1",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.15 <10"
  },
  "scripts": {
    "dev": "pnpm --dir apps/node dev",
    "dev:hmr": "pnpm --dir apps/node dev:hmr",
    "dev:incident": "pnpm --dir apps/node dev:incident",
    "typecheck": "pnpm --dir apps/node typecheck",
    "lint": "pnpm --dir apps/node lint",
    "test": "pnpm --dir apps/node test",
    "test:smoke:codex": "pnpm --dir apps/node test:smoke:codex",
    "test:smoke:local-usage": "pnpm --dir apps/node test:smoke:local-usage",
    "test:smoke:claude-pty": "pnpm --dir apps/node test:smoke:claude-pty",
    "test:smoke:claude-packaged": "pnpm --dir apps/node test:smoke:claude-packaged",
    "test:e2e": "pnpm --dir apps/node test:e2e",
    "test:e2e:runtime": "pnpm --dir apps/node test:e2e:runtime",
    "screenshot:readme": "pnpm --dir apps/node screenshot:readme",
    "package": "pnpm --dir apps/node package",
    "make": "pnpm --dir apps/node make",
    "install:app": "node ./scripts/deploy.mjs",
    "deploy": "node ./scripts/deploy.mjs",
    "deploy:autostart": "node ./scripts/deploy.mjs --autostart",
    "deploy:quick": "node ./scripts/deploy.mjs --skip-build",
    "deploy:uninstall": "node ./scripts/deploy.mjs --uninstall",
    "deploy:mac": "bash ./scripts/deploy-mac.sh",
    "deploy:mac:autostart": "bash ./scripts/deploy-mac.sh --autostart",
    "deploy:mac:quick": "bash ./scripts/deploy-mac.sh --skip-build",
    "deploy:mac:uninstall": "bash ./scripts/deploy-mac.sh --uninstall",
    "deploy:win": "pwsh -NoProfile -File ./scripts/deploy-windows.ps1",
    "deploy:win:autostart": "pwsh -NoProfile -File ./scripts/deploy-windows.ps1 -AutoStart",
    "deploy:win:quick": "pwsh -NoProfile -File ./scripts/deploy-windows.ps1 -SkipBuild",
    "deploy:win:uninstall": "pwsh -NoProfile -File ./scripts/deploy-windows.ps1 -Uninstall",
    "test:shared-cache": "pnpm --dir apps/node test:shared-cache",
    "check:architecture": "pnpm --dir apps/node check:architecture",
    "test:architecture": "pnpm --dir apps/node test:architecture",
    "test:smoke:antigravity": "pnpm --dir apps/node test:smoke:antigravity",
    "check:versions": "node scripts/check-versions.mjs"
  }
}
